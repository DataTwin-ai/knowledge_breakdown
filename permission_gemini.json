{
  "_about": "Your switches. Every script reads them through kp_settings.py; nothing is hard-coded. Fixed paths, tables and thresholds are in Config/settings.json.",
  "run": {
    "ikp": true,
    "mkp": true,
    "akp": true,
    "gkp": true,
    "governance_master": true,
    "fact_catalog": true
  },
  "use_cache": {
    "ikp": true,
    "mkp": true,
    "akp": true,
    "gkp": true,
    "governance_master": true
  },
  "read": {
    "acts": true,
    "rules": false,
    "notifications": false,
    "circulars": false
  },
  "documents": {
    "_about": "Per document on / off by code (e.g. \"CGSTA17\": false). A code not listed follows \"read\" for its kind."
  },
  "scope": {
    "ask_user_input": true,
    "default": "FULL"
  },
  "workers": {
    "_about": "Worker pool: how many units run at the same time, and how many LLM calls each provider may have open at once.",
    "count": 8,
    "max_calls_at_once": {
      "GEMINI": 8,
      "CLAUDE": 6
    }
  },
  "features": {
    "download_missing_pdfs": true,
    "cross_ref_record": true,
    "web_scraping": false,
    "push_amending_notifications": false,
    "gkp_create_groups": true,
    "prompt_caching": true
  },
  "access": {
    "_about": "What the scripts may touch. A folder not listed here is never read or written.",
    "read_folders": [
      "Law",
      "Prompt",
      "Config",
      "Credentials"
    ],
    "write_folders": [
      "Output",
      "Governance_Master",
      "Law",
      "Config"
    ],
    "internet": true,
    "database_delete": true
  },
  "console": {
    "_about": "FLOW = only the flow (workers, units, errors, summary). DETAIL = every engine line too.",
    "show": "FLOW"
  },
  "governance_master": {
    "tsgs": "TOUCHED",
